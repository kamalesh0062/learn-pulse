# LearnPulse AI Production Environment Variables
DATABASE_URL=sqlite:///database/learnpulse.db
# Generate your own, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides for revision kits
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ENVIRONMENT=production
